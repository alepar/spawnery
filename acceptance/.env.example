# Target vars for the acceptance suite. Copy to .env.<target> (e.g. .env.dev) and fill in;
# real .env.* files are gitignored. Loaded via config/target.ts's loadTargetConfig(process.env).

# --- Target ---
# Origin the SPA is served from (webDriver navigates here).
ACC_WEB_ORIGIN=https://blacky.dayton:5173
# Connect-JSON endpoint the apiDriver/cliDriver hit. May equal ACC_WEB_ORIGIN when a gateway
# proxies /cp.v1.SpawnService/* (as Vite does in dev).
ACC_CP_ENDPOINT=https://blacky.dayton:5173
# Free-form label for reporting (not used for prod-safety — that's derived from the URL host).
ACC_ENV=dev

# --- Auth ---
# dev-token | oauth-pop. Production-client coverage uses oauth-pop; dev-token is retained only for
# explicitly isolated destructive fixtures that cannot authenticate after revoking the live signer.
ACC_AUTH_MODE=oauth-pop
# Comma-separated token=owner pairs. Must have at least as many entries as Playwright `workers` —
# never share an owner across workers.
#   dev-token: the shape matches the CP's CP_DEV_TOKENS — token is a static bearer.
#   oauth-pop: token is instead the AS_FAKE_GITHUB `login_hint` used to select (or deterministically
#     auto-register) a distinct fake-GitHub owner per worker — see internal/authsvc/githubfake and
#     acceptance/src/auth/oauthpop.ts. Requires the target to run AS_FAKE_GITHUB (reachable +
#     multi-user, T2/sp-tq0t.13) and a registered OAuth redirect URI of `${ACC_WEB_ORIGIN}/callback`
#     (the AS's and the SPA's shared default — see cmd/authsvc/config.go's derive() and
#     web/src/views/LoginView.tsx's REDIRECT_URI).
ACC_IDENTITY_POOL=acc-owner-1=acc-owner-1,acc-owner-2=acc-owner-2
# Auth Service base URL for oauth-pop mode (authorize/refresh). Optional — defaults to
# ACC_WEB_ORIGIN, mirroring the SPA's own same-origin-via-dev-proxy default (empty VITE_AS_ORIGIN).
ACC_AS_ORIGIN=

# --- Production node verification (required by oauth-pop) ---
# Public inputs only. The client session private keys remain in browser IndexedDB or the isolated
# spawnctl config home created by `spawnctl login --device`.
ACC_ROOT_CA_PEM=/path/to/public-pki/root.pem
ACC_TRUST_DOMAIN=prod.spawnery.internal
ACC_CLOUD_ACCOUNT_ID=spawnery-system
# Per-run rollback checkpoint plus every trusted issuer and its current signed CRL.
ACC_CRL_STATE=/path/to/run/crl-state.json
ACC_CRL_ISSUERS=/path/to/service-intermediate.pem,/path/to/cloud-intermediate.pem,/path/to/self-hosted-intermediate.pem
ACC_CRLS=/path/to/service.crl.pem,/path/to/cloud-node.crl.pem,/path/to/self-hosted-node.crl.pem
# Used only by auth/root-anchored-artifacts.spec.ts after the current signer is revoked. Ordinary
# web, CLI, and oracle fixtures never receive this as an identity or bearer.
ACC_DESTRUCTIVE_DEV_TOKEN=
# ACC_E2E_VM_RUNID is runner-only: scripts/e2e-vm/run.sh writes the matching root-owned marker in
# its fresh VM before exporting the value. Do not set it by hand. Manual acceptance runs must exclude
# the destructive-root-artifacts project unless they are still inside that exact run.sh-managed run.

# --- Safety ---
# Comma-separated allowlist of non-prod hosts (exact or suffix match). localhost/127.0.0.1 are
# always non-prod. Any host NOT on this list is treated as prod (default-deny).
ACC_NONPROD_HOSTS=blacky.dayton,localhost

# --- Version pinning ---
# Target's deployed CP ref/version this run expects (guards against Connect contract skew).
ACC_TARGET_REF=dev
# Build ref of the spawnctl/oracle this run was built from (compared against ACC_TARGET_REF).
ACC_BUILD_REF=dev

# --- CLI driver ---
# Path to the spawnctl binary the cliDriver shells out to.
ACC_SPAWNCTL_BIN=../bin/spawnctl

# --- @agent scenarios (Phase 2+) ---
# Declare whether this target intentionally provides live inference. A deterministic target may
# set 0, producing one reasoned @agent fixme while non-LLM ACP/session tests remain active. When set
# to 1, a real coding-agent app id and pinned CHEAP model are required; missing inputs fail loudly.
ACC_AGENT_INFERENCE_AVAILABLE=1
ACC_AGENT_APP_ID=
ACC_AGENT_MODEL=
# Fallback per-turn token estimate fed into the CostLedger when a turn's usage badge is absent
# (an agent that doesn't report usage).
ACC_AGENT_TOKEN_ESTIMATE=2000

# --- Node (Phase-5 injection observation only) ---
# tests/customization/injection.spec.ts needs a seed app whose agent installs skills (claude or
# codex) so entries materialize under
# `$HOME/**/skills/<name>/SKILL.md` and can be observed via `spawnctl exec`.
# A registered app id whose agent installs skills (claude or codex) — used ONLY by
# tests/customization/injection.spec.ts to spawn the profile-attached-skill observation target.
# No default: there's no safe "which app" assumption. Leaving it unset makes
# that one scenario fail loud naming the missing precondition; every other scenario is unaffected.
ACC_SEED_SKILL_APP_ID=spawnery/secret-app

# --- Skill-staging measurement (@skill-staging; explicit opt-in only) ---
# Comma-separated GitHub "owner/repo[:subdir]" entries. The dedicated S5 lane requires at least
# ACC_SKILL_BUNDLE_SIZE distinct small public repositories containing SKILL.md and fails loudly when
# this is unset or undersized. No default fixture is shipped; curate and review the list externally.
ACC_SKILL_SOURCE_REPOS=
# Number of distinct skills staged per spawn (default 8; must be a finite integer >= 8).
ACC_SKILL_BUNDLE_SIZE=8
# Number of StartSpawn -> ACTIVE samples used for the reported maximum (default 5; finite integer >= 1).
ACC_SKILL_STAGING_ITERATIONS=5

# --- Cost / kill-switch ---
ACC_TOKEN_BUDGET=200000
ACC_WALLCLOCK_MS=1800000

# --- Sweeps ---
# Age (ms) after which a stale acc-* artifact is swept by the pre-run sweep.
ACC_STALE_TTL_MS=3600000

# --- Run identity (optional) ---
# Override the generated run id (useful for correlating a specific CI run).
ACC_RUN_ID=

# --- Phase 3: suspend/resume + fork ---
# Spawnable seed app id used by lifecycle/suspend/fork scenarios (a documented target precondition).
ACC_TEST_APP_ID=opencode

# --- Lifecycle scenarios (Phase 1) ---
# Id of an app/template that exists on the target to spawn from (documented target precondition).
ACC_LIFECYCLE_APP=
# A valid alternate model id (OpenRouter form) for the set-model scenario; MUST differ from the
# app's default model so the cross-check is meaningful.
ACC_TEST_MODEL=

# --- Node admin (@noderestart scenario, SE3) ---
# A HOST shell command that restarts the target's spawnlet — the documented upgrade path
# (`systemctl restart spawnery-node`). tests/lifecycle/node-restart.spec.ts asserts a restart does NOT
# destroy running spawns. scripts/e2e-vm/run.sh exports this automatically for the e2e-VM lane; for other
# targets provide your own, e.g.:
#   ACC_NODE_RESTART_CMD=ssh -i ~/.ssh/spawnery_e2e spawnery@10.0.0.5 sudo systemctl restart spawnery-node
# Unset => the @noderestart scenario FAILS loudly (never skips). On a target whose node you cannot restart,
# exclude it: `npm run test:accept -- --grep-invert @noderestart`.
ACC_NODE_RESTART_CMD=
# Hard cap on the restart command (default 120000).
ACC_NODE_RESTART_TIMEOUT_MS=120000
