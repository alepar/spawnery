# Target vars for the acceptance suite. Copy to .env.<target> (e.g. .env.dev) and fill in;
# real .env.* files are gitignored. Loaded via config/target.ts's loadTargetConfig(process.env).

# --- Target ---
# Origin the SPA is served from (webDriver navigates here).
ACC_WEB_ORIGIN=https://blacky.dayton:5173
# Connect-JSON endpoint the apiDriver/cliDriver hit. May equal ACC_WEB_ORIGIN when a gateway
# proxies /cp.v1.SpawnService/* (as Vite does in dev).
ACC_CP_ENDPOINT=https://blacky.dayton:5173
# Free-form label for reporting (not used for prod-safety — that's derived from the URL host).
ACC_ENV=dev

# --- Auth ---
# dev-token | oauth-pop  (oauth-pop lands in sp-tq0t.3)
ACC_AUTH_MODE=dev-token
# Comma-separated token=owner pairs, same shape as the CP's CP_DEV_TOKENS. Must have at least as
# many entries as Playwright `workers` — never share an owner across workers.
ACC_IDENTITY_POOL=devtoken1=acc-owner-1,devtoken2=acc-owner-2,devtoken3=acc-owner-3

# --- Safety ---
# Comma-separated allowlist of non-prod hosts (exact or suffix match). localhost/127.0.0.1 are
# always non-prod. Any host NOT on this list is treated as prod (default-deny).
ACC_NONPROD_HOSTS=blacky.dayton,localhost

# --- Version pinning ---
# Target's deployed CP ref/version this run expects (guards against Connect contract skew).
ACC_TARGET_REF=dev
# Build ref of the spawnctl/oracle this run was built from (compared against ACC_TARGET_REF).
ACC_BUILD_REF=dev

# --- CLI driver ---
# Path to the spawnctl binary the cliDriver shells out to.
ACC_SPAWNCTL_BIN=../bin/spawnctl

# --- Cost / kill-switch ---
ACC_TOKEN_BUDGET=200000
ACC_WALLCLOCK_MS=1800000

# --- Sweeps ---
# Age (ms) after which a stale acc-* artifact is swept by the pre-run sweep.
ACC_STALE_TTL_MS=3600000

# --- Run identity (optional) ---
# Override the generated run id (useful for correlating a specific CI run).
ACC_RUN_ID=
