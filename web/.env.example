# Production build environment variables.
# Copy to .env.production and fill in the real origins before running `npm run build`.
# These are baked into the bundle at build time and pin the CSP connect-src directive —
# the browser physically cannot contact any other origin once the bundle is signed.
#
# See deploy/web/README.md for the full ops checklist.

# Canonical CP API origin (https, no trailing slash).
# Example: https://cp.spawnery.dev
VITE_CP_ORIGIN=https://cp.example.spawnery.dev

# Canonical AS (Account Service) origin (https, no trailing slash).
# Example: https://as.spawnery.dev
VITE_AS_ORIGIN=https://as.example.spawnery.dev

# OAuth-backed authentication. Production builds require trust material regardless of this flag.
VITE_AUTH_ENABLED=1

# Root CA and SPIFFE identity namespace stamped into the signed SPA bundle.
VITE_ROOT_CA_PEM="-----BEGIN CERTIFICATE-----\nBASE64 ROOT CERTIFICATE\n-----END CERTIFICATE-----"
VITE_TRUST_DOMAIN=prod.spawnery.internal
VITE_CLOUD_ACCOUNT_ID=spawnery-system

# Exactly one cloud and one self-hosted node issuer/CRL pair, encoded as a JSON array.
VITE_NODE_CRLS_JSON='[{"class":"cloud","issuerPEM":"-----BEGIN CERTIFICATE-----\nBASE64 CLOUD ISSUER\n-----END CERTIFICATE-----","crlPEM":"-----BEGIN X509 CRL-----\nBASE64 CLOUD CRL\n-----END X509 CRL-----"},{"class":"self-hosted","issuerPEM":"-----BEGIN CERTIFICATE-----\nBASE64 SELF-HOSTED ISSUER\n-----END CERTIFICATE-----","crlPEM":"-----BEGIN X509 CRL-----\nBASE64 SELF-HOSTED CRL\n-----END X509 CRL-----"}]'
