# The "fake" profile is the fast smoke lane: fake GitHub IdP + dev-token CP auth. These overlay
# the prod-real base (common.env: SPAWNERY_ENV=prod, prod auth) via profile.env, so `--profile fake`
# runs the CP in dev-token mode while the base stays prod-shaped. A future oauth-pop lane gets its
# own profile.github.env WITHOUT the CP_AUTH_MODE=dev overlay (→ real session/PoP auth).

# --- fake GitHub IdP (AS stubs the GitHub login; not dev-gated, valid with SPAWNERY_ENV=prod) ---
AS_FAKE_GITHUB=1
AS_FAKE_GITHUB_ADDR=0.0.0.0:9099
AS_FAKE_GITHUB_BASE_URL=http://@@HOST@@:9099
AS_FAKE_GITHUB_USERS=acc-owner-1,acc-owner-2,acc-owner-3

# --- dev-token CP auth (ACC_AUTH_MODE=dev-token) ---
# CP_DEV_TOKENS maps N dev tokens → N owners: the acceptance identity pool (one owner per worker).
# The node runs enforced intent verification on the production-shaped stack, so it NACKs provisioning
# unless an AS-issued node token and client-signed intent are relayed. The CP always requires both.
# Spawn creation on this stack therefore requires a fully authenticated signing client.
# The pure Connect-JSON api oracle has NO signer, so it CANNOT create spawns here (it is a read/
# cross-check oracle, per design). Tests must create setup spawns via a signing driver (cli/web), not
# api.createSpawn — see sp-te3y follow-up.
CP_AUTH_MODE=dev
CP_DEV_TOKENS=devtoken1=acc-owner-1,devtoken2=acc-owner-2,devtoken3=acc-owner-3
# The node runs the github static-token lane (local Gitea; see gitea.env), where github: mounts use
# one node-static token, not a per-owner AS mint. So the CreateSpawn owner-github-link preflight is
# meaningless here and would wrongly reject — disable it. (github_link_preflight_test.go still covers
# the preflight logic hermetically.)
CP_GITHUB_LINK_PREFLIGHT_DISABLED=1
