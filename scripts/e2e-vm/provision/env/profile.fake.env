# The "fake" profile keeps the production auth topology but replaces GitHub with the disposable
# fake IdP. Ordinary web, oracle, and spawnctl clients still obtain AS-issued paired credentials.

# --- fake GitHub IdP (AS stubs the GitHub login; not dev-gated, valid with SPAWNERY_ENV=prod) ---
AS_FAKE_GITHUB=1
AS_FAKE_GITHUB_ADDR=0.0.0.0:9099
AS_FAKE_GITHUB_BASE_URL=http://@@HOST@@:9099
AS_FAKE_GITHUB_USERS=acc-owner-1,acc-owner-2,acc-owner-3
AS_MAX_FAMILIES=100
AS_DEVICE_PER_MIN=100

# The fake provider still advertises the production github.com facade. Authsvc alone receives the
# fixed Gitea PAT through its private environment file; acceptance links each OAuth identity, CP
# preflights gh:<UUID owner>, and spawnlet uses the dynamic AS-mint proxy/CA path.
GITHUB_API_BASE_URL=https://github.com/api/v1
GITHUB_HOST=github.com

# --- sidecar upstream CA trust override (sp-wwtc.3, e2e/VM profile ONLY) ---
# Merged bundle (system roots + the golden CA; built at provision time — see provision.sh) mounted
# into the sidecar with SSL_CERT_FILE pointed at it, so the sidecar's STRICT, UNMODIFIED upstream
# transport (newDefaultUpstreamTransport — no InsecureSkipVerify) genuinely verifies Gitea's
# github.com cert (sp-wwtc.1) against the golden CA. Production leaves this unset: no mount, no
# env override, no golden CA anywhere near the production sidecar image.
SIDECAR_CA_BUNDLE_FILE=/etc/spawnery/sidecar-ca-bundle/ca-bundle.crt
