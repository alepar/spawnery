SPAWNERY_ENV=prod
SPAWNERY_CONFIG_DIR=/etc/spawnery/config
CP_STORE_DRIVER=postgres
CP_STORE_DSN=postgres://spawnery:spawnery@127.0.0.1:5432/spawnery?sslmode=disable
AS_LISTEN=127.0.0.1:8090
AS_DB_DSN=file:/var/lib/spawnery/authsvc.db?_pragma=foreign_keys(1)
AS_ROOT_CA_PEM=/etc/spawnery/pki/root.pem
AS_INTERMEDIATE_CERT_PEM=/etc/spawnery/pki/self-hosted-intermediate.pem
AS_INTERMEDIATE_KEY_PEM=/etc/spawnery/pki/self-hosted-intermediate-key.pem
AS_SESSION_KEY_PEM=/etc/spawnery/pki/session-key.pem
AS_GITHUB_TOKEN_ENC_KEY=c3Bhd25lcnktZTJlLWdpdGh1Yi1tb3VudC1lbmNrMzI=
AS_PUBLIC_URL=https://@@HOST@@
AS_REDIRECT_URIS=https://@@HOST@@/callback
AS_GITHUB_LINK_REDIRECT_URI=https://@@HOST@@/github/link/callback
AS_GITHUB_POST_REDEEM_REDIRECT=https://@@HOST@@/settings
AS_CP_URL=http://127.0.0.1:8080
AS_CP_RPC_SECRET=e2e-as-cp-secret
CP_LISTEN=127.0.0.1:8080
CP_AS_SESSION_PUBKEYS=/etc/spawnery/pki/session-pub.pem
CP_AS_RPC_SECRET=e2e-as-cp-secret
CP_AS_URL=http://127.0.0.1:8090
NODE_AUTH_MODE=enforced
CP_NODE_LISTEN=127.0.0.1:8081
CP_NODE_ROOT_CA=/etc/spawnery/pki/root.pem
CP_NODE_TLS_CERT=/etc/spawnery/pki/cp-server.pem
CP_NODE_TLS_KEY=/etc/spawnery/pki/cp-server-key.pem
CP_ALLOWED_ORIGINS=https://@@HOST@@
CP_ADDR=http://127.0.0.1:8080
CP_NODE_ADDR=https://127.0.0.1:8081
NODE_ID=node-1
NODE_ID_DIR=/etc/spawnery/pki/node-cloud
NODE_CLASS=cloud
NODE_AS_PUBKEYS=/etc/spawnery/pki/session-pub.pem
NODE_ADVERTISE_IP=@@IP@@
NODE_TERMINAL_ADDR=0.0.0.0:9092
CONTAINER_RUNTIME=runsc
USERNS_MODE=native
POD_DNS=1.1.1.1,8.8.8.8
AGENT_IMAGE=spawnery/agent:dev
SIDECAR_IMAGE=spawnery/sidecar:dev
OPENROUTER_API_KEY=unused
