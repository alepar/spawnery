SPAWNERY_ENV=prod
SPAWNERY_CONFIG_DIR=/etc/spawnery/config
CP_STORE_DRIVER=postgres
CP_STORE_DSN=postgres://spawnery:spawnery@127.0.0.1:5432/spawnery?sslmode=disable
AS_LISTEN=127.0.0.1:8090
AS_TRUST_DOMAIN=prod.spawnery.internal
AS_DB_DSN=file:/var/lib/spawnery/authsvc.db?_pragma=foreign_keys(1)
AS_ROOT_CA_PEM=/etc/spawnery/authsvc/root.pem
AS_INTERMEDIATE_CERT_PEM=/etc/spawnery/authsvc/self-hosted-intermediate.pem
AS_INTERMEDIATE_KEY_PEM=/etc/spawnery/authsvc/self-hosted-intermediate-key.pem
AS_SELF_HOSTED_REVOCATION_CRL=/var/lib/spawnery/authsvc-revocations/self-hosted-node.crl.pem
AS_AUTH_SIGNING_ENVIRONMENT=prod
AS_AUTH_SIGNING_ROOT_PEM=/etc/spawnery/authsvc/root.pem
AS_AUTH_SIGNING_CURRENT_KEY_PEM=/etc/spawnery/authsvc/auth-signer-current-key.pem
AS_AUTH_SIGNING_CURRENT_CHAIN_PEM=/etc/spawnery/authsvc/auth-signer-current-chain.pem
AS_AUTH_SIGNING_NEXT_KEY_PEM=/etc/spawnery/authsvc/auth-signer-next-key.pem
AS_AUTH_SIGNING_NEXT_CHAIN_PEM=/etc/spawnery/authsvc/auth-signer-next-chain.pem
AS_GITHUB_TOKEN_ENC_KEY=c3Bhd25lcnktZTJlLWdpdGh1Yi1tb3VudC1lbmNrMzI=
AS_PUBLIC_URL=https://@@HOST@@
AS_REDIRECT_URIS=https://@@HOST@@/callback
AS_GITHUB_LINK_REDIRECT_URI=https://@@HOST@@/github/link/callback
AS_GITHUB_POST_REDEEM_REDIRECT=https://@@HOST@@/settings
AS_INTERNAL_LISTEN=127.0.0.1:8091
AS_INTERNAL_TRUST_DOMAIN=prod.spawnery.internal
AS_INTERNAL_ROOT_CA=/etc/spawnery/authsvc/root.pem
AS_INTERNAL_CERT=/etc/spawnery/authsvc/authsvc-service.pem
AS_INTERNAL_CHAIN=/etc/spawnery/authsvc/authsvc-service-chain.pem
AS_INTERNAL_KEY=/etc/spawnery/authsvc/authsvc-service-key.pem
AS_INTERNAL_SERVER_NAME=authsvc.internal
AS_INTERNAL_REVOCATION_STATE=/var/lib/spawnery/authsvc-revocations/state.json
AS_INTERNAL_REVOCATION_ISSUERS=/etc/spawnery/authsvc/service-intermediate.pem,/etc/spawnery/authsvc/cloud-intermediate.pem,/etc/spawnery/authsvc/self-hosted-intermediate.pem
AS_INTERNAL_REVOCATION_CRLS=/etc/spawnery/authsvc/service.crl.pem,/etc/spawnery/authsvc/cloud-node.crl.pem,/var/lib/spawnery/authsvc-revocations/self-hosted-node.crl.pem
AS_INTERNAL_REVOCATION_REFRESH_INTERVAL=5s
AS_CP_URL=https://127.0.0.1:8081
AS_CP_SERVER_NAME=cp.internal
CP_LISTEN=127.0.0.1:8080
CP_AUTH_MODE=prod
CP_AUTH_ENVIRONMENT=prod
CP_AUTH_ROOT_CA=/etc/spawnery/cp/root.pem
CP_AUTH_SIGNER_REVOCATION_STATE=/var/lib/spawnery/cp-signer-revocations/state.json
CP_AS_URL=https://127.0.0.1:8091
CP_AS_REVOCATION_URL=https://127.0.0.1:8091/revocations
CP_INTERNAL_LISTEN=127.0.0.1:8081
CP_INTERNAL_TRUST_DOMAIN=prod.spawnery.internal
CP_INTERNAL_ROOT_CA=/etc/spawnery/cp/root.pem
CP_INTERNAL_TLS_CERT=/etc/spawnery/cp/cp-service.pem
CP_INTERNAL_TLS_CHAIN=/etc/spawnery/cp/cp-service-chain.pem
CP_INTERNAL_TLS_KEY=/etc/spawnery/cp/cp-service-key.pem
CP_INTERNAL_SERVER_NAME=authsvc.internal
CP_INTERNAL_REVOCATION_STATE=/var/lib/spawnery/cp-revocations/state.json
CP_INTERNAL_REVOCATION_ISSUERS=/etc/spawnery/cp/service-intermediate.pem,/etc/spawnery/cp/cloud-intermediate.pem,/etc/spawnery/cp/self-hosted-intermediate.pem
CP_INTERNAL_REVOCATION_CRLS=/etc/spawnery/cp/service.crl.pem,/etc/spawnery/cp/cloud-node.crl.pem,/etc/spawnery/cp/self-hosted-node.crl.pem
CP_INTERNAL_REVOCATION_REFRESH=5s
CP_ALLOWED_ORIGINS=https://@@HOST@@
CP_ADDR=http://127.0.0.1:8080
CP_NODE_ADDR=https://127.0.0.1:8081
CP_SERVER_NAME=cp.internal
AS_URL=https://127.0.0.1:8091
AS_SERVER_NAME=authsvc.internal
NODE_AUTH_MODE=enforced
NODE_ID=node-1
NODE_ID_DIR=/etc/spawnery/node
NODE_CLASS=cloud
NODE_ROOT_CA=/etc/spawnery/node/root.pem
NODE_TRUST_DOMAIN=prod.spawnery.internal
NODE_AUTH_ENVIRONMENT=prod
NODE_SIGNER_REVOCATION_STATE=/var/lib/spawnlet/signer-revocations/state.json
NODE_USER_REVOCATION_STATE=/var/lib/spawnlet/user-revocations/revocations.db
NODE_USER_REVOCATION_POLL_INTERVAL=5s
NODE_USER_REVOCATION_REQUEST_TIMEOUT=10s
NODE_USER_REVOCATION_MAX_BACKOFF=1m
NODE_CERTIFICATE_REVOCATION_STATE=/var/lib/spawnlet/certificate-revocations/state.json
NODE_CERTIFICATE_REVOCATION_ISSUERS=/etc/spawnery/node/service-intermediate.pem,/etc/spawnery/node/cloud-intermediate.pem,/etc/spawnery/node/self-hosted-intermediate.pem
NODE_CERTIFICATE_REVOCATION_CRLS=/etc/spawnery/node/service.crl.pem,/etc/spawnery/node/cloud-node.crl.pem,/etc/spawnery/node/self-hosted-node.crl.pem
NODE_CERTIFICATE_REVOCATION_REFRESH_INTERVAL=5s
NODE_ADVERTISE_IP=@@IP@@
NODE_TERMINAL_ADDR=0.0.0.0:9092
CONTAINER_RUNTIME=runsc
USERNS_MODE=native
GETTOKEN_LISTEN_IP=10.234.0.1
POD_DNS=1.1.1.1,8.8.8.8
AGENT_IMAGE=spawnery/agent:dev
SIDECAR_IMAGE=spawnery/sidecar:dev
OPENROUTER_API_KEY=unused
# Transient-tier journal store (Garage S3) — enables suspend/resume + fork on the prod stack. The
# per-boot access key/secret land in journal.env (written by spawnery-garage-bootstrap); the node
# key auto-generates under JOURNAL_ROOT. Well-known DEV garage secrets (see provision.sh).
JOURNAL_BACKEND=s3
JOURNAL_ROOT=/var/lib/spawnlet/journal
JOURNAL_S3_ENDPOINT=127.0.0.1:3900
JOURNAL_S3_BUCKET=spawnery-journal
JOURNAL_S3_REGION=garage
JOURNAL_S3_DISABLE_TLS=true
JOURNAL_GARAGE_ADMIN_ENDPOINT=http://127.0.0.1:3903
JOURNAL_GARAGE_ADMIN_TOKEN=e8a6bb74d9331b884614a992c640234faa408f543fd31ec9
