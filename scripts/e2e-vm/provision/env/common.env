SPAWNERY_ENV=prod
SPAWNERY_CONFIG_DIR=/etc/spawnery/config
CP_STORE_DRIVER=postgres
CP_STORE_DSN=postgres://spawnery:spawnery@127.0.0.1:5432/spawnery?sslmode=disable
AS_LISTEN=127.0.0.1:8090
AS_DB_DSN=file:/var/lib/spawnery/authsvc.db?_pragma=foreign_keys(1)
AS_ROOT_CA_PEM=/etc/spawnery/pki/root.pem
AS_INTERMEDIATE_CERT_PEM=/etc/spawnery/pki/self-hosted-intermediate.pem
AS_INTERMEDIATE_KEY_PEM=/etc/spawnery/pki/self-hosted-intermediate-key.pem
AS_SESSION_KEY_PEM=/etc/spawnery/pki/session-key.pem
# AS's node-mTLS TLS listener (sp-hsqs + sp-wwtc mint wiring): as-server.{crt,key} (gen-pki.sh) are
# signed by the same root.pem as everything else in this PKI, so the node's pinned root (its identity
# dir's root.pem, same file) and the CP/Caddy's system trust (golden CA installed by provision.sh)
# both already verify it — no new trust anchor to distribute. ClientCA reuses AS_ROOT_CA_PEM's file:
# the TLS-handshake-layer pool (tls.Config.ClientCAs) and nodeIdentityMiddleware's CHAIN-verification
# pool are conceptually distinct but are the same CA here, as they usually are (see AS_CLIENT_CA doc
# in cmd/authsvc/main.go). ClientAuth is VerifyClientCertIfGiven, so browsers/OAuth traffic (no client
# cert) and Caddy's @as reverse_proxy backend (also no client cert) are unaffected.
AS_TLS_CERT=/etc/spawnery/pki/as-server.crt
AS_TLS_KEY=/etc/spawnery/pki/as-server.key
AS_CLIENT_CA=/etc/spawnery/pki/root.pem
AS_GITHUB_TOKEN_ENC_KEY=c3Bhd25lcnktZTJlLWdpdGh1Yi1tb3VudC1lbmNrMzI=
AS_PUBLIC_URL=https://@@HOST@@
AS_REDIRECT_URIS=https://@@HOST@@/callback
AS_GITHUB_LINK_REDIRECT_URI=https://@@HOST@@/github/link/callback
AS_GITHUB_POST_REDEEM_REDIRECT=https://@@HOST@@/settings
AS_CP_URL=http://127.0.0.1:8080
AS_CP_RPC_SECRET=e2e-as-cp-secret
CP_LISTEN=127.0.0.1:8080
CP_AS_SESSION_PUBKEYS=/etc/spawnery/pki/session-pub.pem
CP_AS_RPC_SECRET=e2e-as-cp-secret
# CP -> AS: now TLS (as-server.crt is root-signed; the CP is a host process on this VM and already
# trusts the golden root via the system trust store provision.sh installs — see "golden CA into the
# VM's OWN trust" below — so both CP->AS callers that use http.DefaultClient (the GitHub link-status
# preflight checker and the revocation-feed poller, internal/cp) verify it with zero code change).
CP_AS_URL=https://127.0.0.1:8090
NODE_AUTH_MODE=enforced
CP_NODE_LISTEN=127.0.0.1:8081
CP_NODE_ROOT_CA=/etc/spawnery/pki/root.pem
CP_NODE_TLS_CERT=/etc/spawnery/pki/cp-server.pem
CP_NODE_TLS_KEY=/etc/spawnery/pki/cp-server-key.pem
CP_ALLOWED_ORIGINS=https://@@HOST@@
CP_ADDR=http://127.0.0.1:8080
CP_NODE_ADDR=https://127.0.0.1:8081
NODE_ID=node-1
NODE_ID_DIR=/etc/spawnery/pki/node-cloud
NODE_CLASS=cloud
NODE_AS_PUBKEYS=/etc/spawnery/pki/session-pub.pem
NODE_ADVERTISE_IP=@@IP@@
NODE_TERMINAL_ADDR=0.0.0.0:9092
# Node -> AS (sp-wwtc mint wiring): fires nodeGitHubMint's enforced/prod branch (cmd/spawnlet/main.go)
# so cfg.GitHubMint != nil, which is what actually switches on the per-spawn MITM CA / HTTP_PROXY /
# CA-bundle plumbing in internal/node/attach.go (GitHubControlEnabled) — for EVERY spawn with a github
# mount, independent of which credential lane resolves the git token (GITHUB_STATIC_TOKEN stays set in
# gitea.env, so that lane — not a fresh AS mint — still supplies the actual credential; see
# profile.fake.env's CP_GITHUB_LINK_PREFLIGHT_DISABLED comment for the full rationale).
# The node reuses its EXISTING enrolled mTLS identity (NODE_ID_DIR) for this dial — nodeGitHubMint()
# calls the same nodeid.Load(dir).MTLSClient() as the CP dial, so no separate node-side cert/key config
# exists or is needed here; id.RootPEM (node-cloud/root.pem, same root.pem as everywhere else in this
# PKI) already verifies as-server.crt.
AS_URL=https://127.0.0.1:8090
CONTAINER_RUNTIME=runsc
USERNS_MODE=native
POD_DNS=1.1.1.1,8.8.8.8
AGENT_IMAGE=spawnery/agent:dev
SIDECAR_IMAGE=spawnery/sidecar:dev
OPENROUTER_API_KEY=unused
# Transient-tier journal store (Garage S3) — enables suspend/resume + fork on the prod stack. The
# per-boot access key/secret land in journal.env (written by spawnery-garage-bootstrap); the node
# key auto-generates under JOURNAL_ROOT. Well-known DEV garage secrets (see provision.sh).
JOURNAL_BACKEND=s3
JOURNAL_ROOT=/var/lib/spawnlet/journal
JOURNAL_S3_ENDPOINT=127.0.0.1:3900
JOURNAL_S3_BUCKET=spawnery-journal
JOURNAL_S3_REGION=garage
JOURNAL_S3_DISABLE_TLS=true
JOURNAL_GARAGE_ADMIN_ENDPOINT=http://127.0.0.1:3903
JOURNAL_GARAGE_ADMIN_TOKEN=e8a6bb74d9331b884614a992c640234faa408f543fd31ec9
